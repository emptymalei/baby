  year      =  2016,
  url       = "https://dx.doi.org/10.1542/pir.2014-0103",
  file      = "All Papers/baby/development/Scharf et al. 2016 - Developmental milestones.pdf",
  keywords  = "child development; developmental delay",
  doi       = "10.1542/pir.2014-0103",
  pmid      =  26729779,
  issn      = "0191-9601,1526-3347",
  language  = "en"
}

